# This file replaces (rather than merges with) .gitignore for Chabokan uploads.
.git/
.github/
node_modules/
.pnp
.pnp.*
.yarn/
.next/
.vinext/
dist/
out/
coverage/
next-env.d.ts
*.tsbuildinfo

# Local secrets, customer records, and checkout-only state must never be uploaded.
.env*
.dev.vars*
.chabok.json
*.pem
*.key
*.sqlite
*.sqlite-*
*.db
*.db-*
data/
.aws/
.wrangler/
.sites-runtime/
.netlify/
.agents/
.codex/
outputs/
work/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
